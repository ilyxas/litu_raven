{
  "project": {
    "name": "Raven",
    "target": "ESP32-S3",
    "branch_intent": "RND: delivery receipts and owner execution with virtual arms; FC retained as alternate boot mode",
    "principle": "Concrete product objects may change freely; Activities, Services, State, Events, Gateways, Platform adapters, and the owner-context execution model remain explicit architectural roles until real hardware proves that a boundary must change."
  },
  "runtime_flow": [
    "TCP Protocol / FrameReader",
    "Dispatcher -> synchronous delivery ACK/NACK",
    "Reserved critical / ordered / latest-value Inbox",
    "Executor -> ArmService / DualArmActivity",
    "OperationState -> status polling and outbound telemetry"
  ],
  "alternate_fc_flow": [
    "EspUartPort",
    "MspClient",
    "BetaflightMspClient",
    "FlightControllerService",
    "FlightControllerState"
  ],
  "components": [
    {
      "name": "raven_runtime",
      "architectural": ["Message", "Inbox", "Dispatcher", "Component", "Executor"],
      "note": "Fixed-storage transport-independent execution substrate"
    },
    {
      "name": "raven_rnd",
      "product": ["ArmService", "DualArmActivity", "SimArmDriver", "OperationState", "Protocol", "FrameReader"],
      "note": "Portable prototype behavior and deterministic self-tests"
    },
    {
      "name": "raven_rnd_esp",
      "product": ["OwnerTask", "Wi-Fi/TCP adapters", "Sensors", "Telemetry", "TCP loopback tests"],
      "note": "ESP backend; virtual actuators only; no iOS source changes"
    },
    {
      "name": "raven_core",
      "architectural": ["BaseTask", "TaskMessage", "SystemMonitorTask"],
      "product": []
    },
    {
      "name": "raven_activities",
      "architectural": ["BaseActivity"],
      "product": [],
      "note": "The role is preserved; no concrete product Activity exists yet."
    },
    {
      "name": "raven_services",
      "architectural": ["BaseService"],
      "product": ["FlightControllerService"]
    },
    {
      "name": "raven_state",
      "architectural": ["Thread-safe canonical state"],
      "product": ["FlightControllerState"]
    },
    {
      "name": "raven_events",
      "architectural": ["EventBus"],
      "product": ["FLIGHT_CONTROLLER_EVENTS"]
    },
    {
      "name": "raven_platform",
      "architectural": ["ILink", "IServer", "ISerialPort"],
      "product": ["EspUartPort"],
      "preserved": ["TcpClientLink", "TcpSessionLink", "TcpServer"]
    },
    {
      "name": "raven_gateways",
      "architectural": [
        "DecoderRegistry",
        "EncoderRegistry",
        "NetworkGateway",
        "NetworkClientGateway"
      ],
      "product": ["MspV1Codec", "MspV1Parser", "MspClient", "BetaflightMspClient"]
    },
    {
      "name": "main",
      "architectural": ["Explicit product composition root"],
      "product": ["start_rnd_runtime (default)", "start_product_runtime (alternate)"]
    }
  ],
  "alternate_fc_milestone": {
    "mode": "read-only",
    "requests": ["MSP_API_VERSION", "MSP_FC_VARIANT", "MSP_FC_VERSION"],
    "write_commands_exposed": false,
    "hardware_link_enabled_by_default": false
  }
}
