menu "Raven Flight Controller"

config RAVEN_FC_LINK_ENABLED
    bool "Enable Betaflight MSP link"
    default n
    help
        Enable the dedicated full-duplex UART link between Raven and the
        Betaflight flight controller. Keep this disabled until the physical
        UART pads, ESP32-S3 GPIOs, and power wiring have been verified.

if RAVEN_FC_LINK_ENABLED

config RAVEN_FC_UART_PORT
    int "ESP32-S3 UART controller"
    range 1 2
    default 1
    help
        UART0 is intentionally excluded so the product link cannot silently
        take over the default console UART.

config RAVEN_FC_UART_TX_GPIO
    int "ESP32-S3 TX GPIO"
    range 0 48
    default 17

config RAVEN_FC_UART_RX_GPIO
    int "ESP32-S3 RX GPIO"
    range 0 48
    default 18

config RAVEN_FC_MSP_BAUD
    int "MSP baud rate"
    range 9600 1000000
    default 115200

config RAVEN_FC_UART_RX_BUFFER_SIZE
    int "UART RX ring buffer size"
    range 256 8192
    default 2048

config RAVEN_FC_POLL_PERIOD_MS
    int "Link-health polling period (ms)"
    range 100 10000
    default 1000

config RAVEN_FC_RESPONSE_TIMEOUT_MS
    int "MSP response timeout (ms)"
    range 20 2000
    default 250

config RAVEN_FC_DISCONNECT_FAILURES
    int "Failures before link-down"
    range 1 20
    default 3

endif

endmenu
