menu "Raven architecture demo"
config RAVEN_RND_RUNTIME
    bool "Run the virtual two-arm architecture prototype"
    default y
    select LWIP_SO_LINGER
    help
        Runs mock actuators, independent owner tasks, TCP delivery receipts,
        operation status polling and telemetry. Does not drive actuator GPIOs.
config RAVEN_RND_SELF_TEST
    bool "Run deterministic and TCP loopback tests at boot"
    default n
    depends on RAVEN_RND_RUNTIME
config RAVEN_BLE_ENABLED
    bool "Bluetooth Serial Connect server (FFE0/FFE1)"
    default y
    depends on RAVEN_RND_RUNTIME && BT_NIMBLE_ENABLED
    help
        Advertises Raven-BLE and exposes a newline ASCII console and demo controls.
        Uses simulated arms. Subscribe to FFE1 notifications before writing.
config RAVEN_RND_PORT
    int "Incoming TCP command port"
    range 1024 65535
    default 8080
config RAVEN_RND_WIFI_SSID
    string "Station SSID (empty starts the Raven-RND development AP)"
    default ""
config RAVEN_RND_WIFI_PASSWORD
    string "Station password"
    default ""
config RAVEN_RND_TELEMETRY_HOST
    string "Outbound telemetry IPv4 (empty disables external telemetry)"
    default ""
config RAVEN_RND_TELEMETRY_PORT
    int "Outbound telemetry port"
    range 1024 65535
    default 8080
endmenu

menu "Raven Flight Controller"

config RAVEN_FC_LINK_ENABLED
    bool "Enable Betaflight MSP link"
    default n
    help
        Enable the dedicated full-duplex UART link between Raven and the
        Betaflight flight controller. Keep this disabled until the physical
        UART pads, ESP32-S3 GPIOs, and power wiring have been verified.

if RAVEN_FC_LINK_ENABLED

config RAVEN_FC_UART_PORT
    int "ESP32-S3 UART controller"
    range 1 2
    default 1
    help
        UART0 is intentionally excluded so the product link cannot silently
        take over the default console UART.

config RAVEN_FC_UART_TX_GPIO
    int "ESP32-S3 TX GPIO"
    range 0 48
    default 17

config RAVEN_FC_UART_RX_GPIO
    int "ESP32-S3 RX GPIO"
    range 0 48
    default 18

config RAVEN_FC_MSP_BAUD
    int "MSP baud rate"
    range 9600 1000000
    default 115200

config RAVEN_FC_UART_RX_BUFFER_SIZE
    int "UART RX ring buffer size"
    range 256 8192
    default 2048

config RAVEN_FC_POLL_PERIOD_MS
    int "Link-health polling period (ms)"
    range 100 10000
    default 1000

config RAVEN_FC_RESPONSE_TIMEOUT_MS
    int "MSP response timeout (ms)"
    range 20 2000
    default 250

config RAVEN_FC_DISCONNECT_FAILURES
    int "Failures before link-down"
    range 1 20
    default 3

endif

endmenu
